{
  "name": "dsh-image-editor",
  "version": "0.0.1",
  "description": "Shenhuo AI layer editing integration for DeepSeek Harness. Initial development scaffold; editing is not available yet.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["src", "locale/*.json", "assets/icon-red-transparent.png", "docs", "cordis.patch.yml", "README.md", "README.en.md", "CONTRIBUTING.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "check": "node --check src/index.js",
    "test": "node --test test/*.test.js",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-alpha.2 <0.3.0-0"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "shenhuo", "image-editor", "layer-editor"],
  "author": "chenyth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenyth/dsh-image-editor.git"
  },
  "bugs": { "url": "https://github.com/chenyth/dsh-image-editor/issues" },
  "homepage": "https://github.com/chenyth/dsh-image-editor#readme",
  "icon": "./assets/icon-red-transparent.png",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
